#!/usr/bin/env php
<?php

use Dew\Cli\Commands\CliCommand;
use Dew\Cli\Commands\ConnectCommand;
use Dew\Cli\Commands\DatabaseCreateCommand;
use Dew\Cli\Commands\DatabaseDeleteCommand;
use Dew\Cli\Commands\DeployCommand;
use Dew\Cli\Commands\InitCommand;
use Dew\Cli\Commands\LoginCommand;
use Dew\Cli\Commands\RollbackCommand;
use Dew\Cli\Configuration\FileRepository;
use Dew\Cli\Dew;
use Dew\Cli\FileManifest;
use Symfony\Component\Console\Application;

if (file_exists(__DIR__.'/vendor/autoload.php')) {
    require_once __DIR__.'/vendor/autoload.php';
} else {
    require_once __DIR__.'/../../autoload.php';
}

$rootPath = getcwd();
$client = Dew::make();
$config = FileRepository::createFromEnvironment();
$manifest = new FileManifest($rootPath);

if ($config->has('token')) {
    $client->setToken($config->get('token'));
}

$app = new Application('Dew CLI', 'v0.0.1');
$app->add(new LoginCommand($client, $config));
$app->add(new InitCommand($client, $config, $manifest, $rootPath));
$app->add(new ConnectCommand($client, $config, $manifest));
$app->add(new DatabaseCreateCommand);
$app->add(new DatabaseDeleteCommand);
$app->add(new CliCommand);
$app->add(new DeployCommand);
$app->add(new RollbackCommand);

$app->run();
